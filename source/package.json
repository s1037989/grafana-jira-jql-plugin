{
  "name": "jirajql-datasource",
  "version": "1.0.0",
  "private": true,
  "description": "Jira JQL to Grafana tables and original JSON through Grafana's secure data proxy",
  "scripts": {
    "build": "npm run typecheck && webpack --mode production && node scripts/verify-build.cjs",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.cjs"
  },
  "dependencies": {
    "@grafana/data": "12.4.0",
    "@grafana/runtime": "12.4.0",
    "@grafana/ui": "12.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "copy-webpack-plugin": "12.0.2",
    "jsdom": "26.1.0",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "webpack": "5.99.9",
    "webpack-cli": "6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
